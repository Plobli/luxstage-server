# LuxStage — SaaS-Image.
# Unterschiede zum Self-Hosted-Dockerfile:
#  - kein Bootstrap-Schritt (entrypoint.saas.sh startet nur den Server)
#  - Native-Module in separater Stage gebaut, Build-Tools NICHT im Runtime-Image

# ── Build-Stage: Web-App ──────────────────────────────────────────────────────
FROM node:22-alpine AS web-builder

WORKDIR /build
COPY package.json package-lock.json ./
COPY web-app/package.json ./web-app/
COPY server/package.json ./server/
RUN npm ci --silent
COPY shared/ ./shared/
COPY web-app/ ./web-app/
RUN npm run build --workspace=web-app

# ── Build-Stage: Native-Module (bcrypt, sharp, better-sqlite3) ────────────────
FROM node:22-alpine AS deps-builder

RUN apk add --no-cache python3 make g++ vips-dev
WORKDIR /app
COPY package.json package-lock.json ./
COPY web-app/package.json ./web-app/
COPY server/package.json ./server/
RUN npm ci --omit=dev --silent

# ── Runtime-Stage ─────────────────────────────────────────────────────────────
FROM node:22-alpine

# Laufzeit-Bibliothek für sharp sowie tar für Mandanten-Backups (tenant-backup.js) — keine Compiler.
RUN apk add --no-cache vips tar

WORKDIR /app
COPY package.json package-lock.json ./
# Fertig kompilierte Module aus der deps-Stage übernehmen
COPY --from=deps-builder /app/node_modules /app/node_modules

COPY server/ ./server/
COPY shared/ ./shared/
COPY entrypoint.saas.sh ./entrypoint.saas.sh
RUN chmod +x ./entrypoint.saas.sh

# router.js erwartet ../web-app/dist relativ zu server/
COPY --from=web-builder /build/web-app/dist /app/web-app/dist

EXPOSE 3000

ENTRYPOINT ["/app/entrypoint.saas.sh"]
