# LuxStage SaaS — Umgebungsvariablen
# Kopieren nach .env und ausfüllen. Für docker-compose.saas.yml.

# ── Pflicht ───────────────────────────────────────────────────────────────────

# Mindestens 32 zufällige Zeichen. Generieren: openssl rand -hex 32
JWT_SECRET=

# Basis-Domain für Mandanten-Subdomains (team-x.<BASE_DOMAIN>).
# Aktiviert den SaaS-/Subdomain-Modus.
BASE_DOMAIN=luxstage.app

# Öffentliche URL (für Links in Registrierungs-Mails).
APP_URL=https://luxstage.app

# Erlaubte CORS-Origins, kommasepariert. In der Regel die eigene(n) Domain(s).
CORS_ORIGINS=https://luxstage.app

# Caddy setzt X-Forwarded-For für die Client-IP im Rate Limiting.
TRUST_PROXY=true

# ── SMTP (Pflicht für Registrierung / Doppel-Opt-In) ──────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LuxStage <noreply@luxstage.app>

# ── Betreiber-Panel (admin.<BASE_DOMAIN>) ─────────────────────────────────────
# Ohne OPERATOR_PASSWORD ist das Panel deaktiviert.
OPERATOR_USER=operator
OPERATOR_PASSWORD=
