{
  "name": "luxstage-monorepo",
  "version": "2026.9.8",
  "private": true,
  "workspaces": [
    "server",
    "web-app"
  ],
  "scripts": {
    "audit:structure": "eslint -c eslint.audit.config.mjs server web-app/src shared",
    "audit:duplication": "jscpd",
    "audit": "node -e \"const {execSync}=require('child_process'); for (const s of ['audit:structure','audit:duplication']) { try { execSync('npm run '+s, {stdio:'inherit'}) } catch {} }\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "better-sqlite3": "^12.8.0",
    "zod": "^4.5.4"
  },
  "allowScripts": {
    "vue-demi@0.14.10": true,
    "bcrypt@6.0.0": true,
    "better-sqlite3@12.9.0": true,
    "esbuild@0.25.12": true,
    "sharp@0.33.5": true
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.10.0",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-vue": "^10.10.0",
    "jscpd": "^5.1.2",
    "vue-eslint-parser": "^10.4.1"
  }
}
