# Pflicht: mindestens 32 zufällige Zeichen
# Generieren: openssl rand -hex 32
JWT_SECRET=

# Kommasepariert, alle Origins von denen die Web-App geladen wird
# Beispiel: http://luxstage.local,http://192.168.1.100,https://luxstage.example.com
CORS_ORIGINS=

# Nur hinter einem vertrauenswürdigen Reverse Proxy aktivieren, der X-Forwarded-For setzt
TRUST_PROXY=false

# Pflicht: E-Mail-Adresse des Admin-Nutzers — dient zugleich als Login-Name
ADMIN_EMAIL=

# Pflicht: Passwort für den Admin-Nutzer (beim ersten Start erforderlich)
ADMIN_PASSWORD=

# Optional: KI-Features (Anthropic Claude)
ANTHROPIC_API_KEY=
