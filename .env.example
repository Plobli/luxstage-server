# Pflicht: mindestens 32 zufällige Zeichen
# Generieren: openssl rand -hex 32
JWT_SECRET=

# Kommasepariert, alle Origins von denen die Web-App geladen wird
# Beispiel: http://luxstage.local,http://192.168.1.100,https://luxstage.example.com
CORS_ORIGINS=

# Nur hinter einem vertrauenswürdigen Reverse Proxy aktivieren, der X-Forwarded-For setzt
TRUST_PROXY=false

# Lokal: Mandanten laufen unter <team>.localhost (Produktion: z. B. luxstage.app)
BASE_DOMAIN=localhost

# Nur lokal (npm run dev:seed -w server): Test-Mandant <DEV_TENANT> (Vite-Proxy setzt den Host) mit diesem Admin
DEV_TENANT=lokal
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: KI-Features (Anthropic Claude) — z.B. Kreisliste-Scan per Vision
ANTHROPIC_API_KEY=

# Optional: Newsletter-Double-Opt-in bei Registrierung über Brevo
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_DOI_TEMPLATE_ID=
BREVO_DOI_REDIRECT_URL=
