{
  "name": "luxstage-web",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test:e2e": "playwright test",
    "tolgee:push": "sh -c 'set -a; . ./.env.development.local; set +a; tolgee push --force-mode NO_FORCE'",
    "tolgee:pull-nach änderungen-in-tolgee": "sh -c 'set -a; . ./.env.development.local; set +a; tolgee pull -d \"\"'",
    "tolgee:sync-nach-änderungen-im-code": "sh -c 'set -a; . ./.env.development.local; set +a; tolgee push --force-mode OVERRIDE && tolgee pull -d \"\"'"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tiptap/extension-table": "^3.22.5",
    "@tiptap/extension-task-item": "^3.22.5",
    "@tiptap/extension-task-list": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.2",
    "@tiptap/vue-3": "^3.22.2",
    "@tolgee/vue": "^7.1.3",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vueuse/core": "^14.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "lucide-vue-next": "^1.0.0",
    "reka-ui": "^2.9.6",
    "sortablejs": "^1.15.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "vue": "^3.5.32",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tolgee/cli": "^2.20.0",
    "@types/dagre": "^0.7.54",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.1",
    "dotenv": "^17.4.2",
    "playwright": "^1.62.1",
    "typescript": "^6.0.3",
    "vite": "^6.4.1",
    "vue-tsc": "^3.2.7"
  }
}
